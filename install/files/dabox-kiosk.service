[Unit]
Description=da-box kiosk (cage + box UI) on tty1
After=systemd-user-sessions.service dabox-service.service plymouth-quit-wait.service
Wants=dabox-service.service
Conflicts=getty@tty1.service

[Service]
User=kid
PAMName=dabox-kiosk
WorkingDirectory=/home/kid
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
EnvironmentFile=/etc/dabox/kiosk.env
# -d: no window decorations. No -s, so Ctrl+Alt+F<n> cannot switch to another console.
ExecStart=/usr/bin/cage -d -- /opt/dabox/bin/dabox-session
Restart=always
RestartSec=1

[Install]
WantedBy=graphical.target
