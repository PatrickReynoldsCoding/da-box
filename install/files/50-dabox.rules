// The da-box service (user tvbox) may set up Wi-Fi, set the time zone, power off
// the box, mount USB sticks, and start the system update and the da-box update (only those units).
polkit.addRule(function (action, subject) {
  if (subject.user !== "tvbox") {
    return polkit.Result.NOT_HANDLED;
  }
  if (action.id === "org.freedesktop.systemd1.manage-units") {
    var unit = action.lookup("unit");
    var startsUpdate = (unit === "dabox-update.service" || unit === "dabox-upgrade.service") && action.lookup("verb") === "start";
    return startsUpdate ? polkit.Result.YES : polkit.Result.NOT_HANDLED;
  }
  var allowed = action.id.indexOf("org.freedesktop.NetworkManager.") === 0 ||
    action.id === "org.freedesktop.timedate1.set-timezone" ||
    action.id === "org.freedesktop.login1.power-off" ||
    action.id === "org.freedesktop.login1.power-off-multiple-sessions" ||
    action.id === "org.freedesktop.login1.reboot" ||
    action.id === "org.freedesktop.login1.reboot-multiple-sessions" ||
    action.id === "org.freedesktop.udisks2.filesystem-mount" ||
    action.id === "org.freedesktop.udisks2.filesystem-mount-other-seat";
  return allowed ? polkit.Result.YES : polkit.Result.NOT_HANDLED;
});
